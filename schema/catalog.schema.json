{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SEA.AI document library catalog",
  "description": "Every published file: where it is stored, which products list it, and as which document type.",
  "type": "object",
  "required": ["repository", "products", "releases", "files"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$" },
    "products": {
      "description": "Product id -> display name. Ids are folder names under products/.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]+$" },
      "additionalProperties": { "type": "string" }
    },
    "releases": {
      "description": "Release tag -> title and notes. One release per component version.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]+(-[a-z]+)*-[0-9][0-9A-Za-z.-]*$" },
      "additionalProperties": {
        "type": "object",
        "required": ["title", "notes"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "notes": { "type": "string", "minLength": 1 }
        }
      }
    },
    "manuals": {
      "description": "Product id -> its online user manual, published on the SEA.AI manuals site. Linked, not stored here.",
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]+$" },
      "additionalProperties": {
        "type": "object",
        "required": ["title", "version", "summary", "url", "pdf", "languages"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "version": { "description": "Software version the manual describes.", "type": "string", "minLength": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "url": { "description": "Online manual, English.", "type": "string", "pattern": "^https://sea-ai\\.github\\.io/manuals/" },
          "pdf": { "description": "Printable PDF of the manual.", "type": "string", "pattern": "^https://sea-ai\\.github\\.io/manuals/.+\\.pdf$" },
          "languages": {
            "description": "Language code (ISO 639-1) -> online manual in that language; must include en.",
            "type": "object",
            "required": ["en"],
            "propertyNames": { "pattern": "^[a-z]{2}$" },
            "additionalProperties": { "type": "string", "pattern": "^https://sea-ai\\.github\\.io/manuals/" }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "products", "size", "sha256"],
        "additionalProperties": false,
        "properties": {
          "title": {
            "description": "File name shown to visitors. For release files, also the asset label.",
            "type": "string",
            "pattern": "^[^#?%/\\\\<>\"\\s][^#?%/\\\\<>\"]*[^#?%/\\\\<>\"\\s]$"
          },
          "products": {
            "description": "Product id -> category on that product's page: software releases, desktop application, CAD (2D drawings, 3D models), guides, wiring diagrams, datasheets.",
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "enum": ["software", "desktop", "cad", "guides", "wiring", "datasheets"] }
          },
          "path": { "description": "Documents: path in this repo.", "type": "string" },
          "release": { "description": "Software and CAD: release tag holding the file.", "type": "string" },
          "asset": {
            "description": "Asset name GitHub stored (it rewrites spaces to dots); the download URL uses it.",
            "type": "string",
            "pattern": "^[^\\s/#?%]+$"
          },
          "size": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "oneOf": [
          { "required": ["path"], "not": { "required": ["release"] } },
          { "required": ["release", "asset"], "not": { "required": ["path"] } }
        ]
      }
    }
  }
}
